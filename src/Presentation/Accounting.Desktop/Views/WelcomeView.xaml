<UserControl x:Class="Accounting.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dönem Bilgi Bandı -->
        <Border Grid.Row="0"
                Background="#EAF3FB"
                BorderBrush="#D0E3F5"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding IsCompanyInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding CompanyPeriodInfo}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#2C5C8F"
                       VerticalAlignment="Center" />
        </Border>

        <!-- İçerik -->
        <Grid Grid.Row="1" Margin="64">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding WelcomeMessage}"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,24" />

            <Border Grid.Row="1"
                    Background="#F9F9F9"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Hızlı Başlangıç"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />
                    <TextBlock Text="• Üst menüden 'Muhasebe → Hesap Planı İşlemleri' seçin"
                               Margin="0,4,0,4" />
                    <TextBlock Text="• Yevmiye fişi girmek için 'Muhasebe → Yevmiye İşlemleri'"
                               Margin="0,4,0,4" />
                    <TextBlock Text="• Raporlar için 'Muhasebe → Raporlar'"
                               Margin="0,4,0,4" />
                    <TextBlock Text="• Firma değiştirmek için üstteki firma kutusunu kullanın"
                               Margin="0,4,0,4" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>