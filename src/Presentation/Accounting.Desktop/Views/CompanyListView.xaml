<UserControl x:Class="Accounting.Desktop.Views.CompanyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Firma Listesi"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="#EAF3FB"
                BorderBrush="#D0E3F5"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,8"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filtre:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <RadioButton Content="Tümü"
                             GroupName="CompanyFilter"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Tümü"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0" />

                <RadioButton Content="Aktif"
                             GroupName="CompanyFilter"
                             IsChecked="{Binding IsFilterActive, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Aktif"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0" />

                <RadioButton Content="Pasif"
                             GroupName="CompanyFilter"
                             IsChecked="{Binding IsFilterPassive, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Pasif"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <dxg:GridControl Grid.Row="2"
                         x:Name="CompanyGrid"
                         ItemsSource="{Binding Companies}"
                         SelectedItem="{Binding SelectedCompany}"
                         AutoGenerateColumns="None"
                         MouseDoubleClick="OnGridMouseDoubleClick">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="ShortName" Header="Kısa Ad" Width="180" />
                <dxg:GridColumn FieldName="Name" Header="Uzun Ad" Width="320" />
                <dxg:GridColumn FieldName="IdentityNumber" Header="TC Kimlik No" Width="140">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="RegEx" Mask="[0-9]*" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="TaxNumber" Header="Vergi No" Width="140">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="RegEx" Mask="[0-9]*" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="IsActive" Header="Aktif" Width="80" />
            </dxg:GridControl.Columns>

            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="False"
                               ShowGroupPanel="False"
                               ShowSearchPanelMode="Never"
                               NavigationStyle="Row"
                               AutoWidth="True"
                               AlternateRowBackground="#F5F8FB" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>