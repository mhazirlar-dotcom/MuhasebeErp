<UserControl x:Class="Accounting.Desktop.Views.PeriodEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:behaviors="clr-namespace:Accounting.Desktop.Behaviors">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Başlık -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,16" />

            <!-- Row 1: Dönem Seçimi (Yıl + Özel Dönem + Ay) -->
            <Border Grid.Row="1"
                    Background="#EAF3FB"
                    BorderBrush="#D0E3F5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Yıl *"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,8" />
                    <Border Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource FieldBorderStyle}"
                            Margin="0,0,0,8">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding AvailableYears}"
                                          SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                          IsEnabled="{Binding IsYearEditable}"
                                          NullText="Yıl seçin" />
                    </Border>

                    <dxe:CheckEdit Grid.Row="0" Grid.Column="3"
                                   Content="Özel Dönem"
                                   IsChecked="{Binding IsSpecialPeriod}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                    <TextBlock Grid.Row="0" Grid.Column="6"
                               Text="Başlangıç Ayı *"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,8"
                               Visibility="{Binding IsMonthSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Grid.Row="0" Grid.Column="7"
                            Style="{StaticResource FieldBorderStyle}"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsMonthSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding AvailableMonths}"
                                          DisplayMember="Name"
                                          SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                          NullText="Ay seçin" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Başlangıç"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Border Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource FieldBorderStyle}"
                            Background="#F0F0F0">
                        <dxe:DateEdit EditValue="{Binding StartDateNullable, Mode=OneWay}"
                                      IsReadOnly="True" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Text="Bitiş"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Border Grid.Row="1" Grid.Column="4"
                            Style="{StaticResource FieldBorderStyle}"
                            Background="#F0F0F0"
                            MinWidth="160">
                        <dxe:DateEdit EditValue="{Binding EndDateNullable, Mode=OneWay}"
                                      IsReadOnly="True" />
                    </Border>
                </Grid>
            </Border>

            <!-- Row 2: ORTAK BİLGİLER -->
            <Border Grid.Row="2"
                    Background="#F9F9F9"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                               Text="ORTAK BİLGİLER"
                               FontSize="13" FontWeight="Bold" Foreground="#1F4E79"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Kapanış Tarihi" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:DateEdit EditValue="{Binding FinalizationDateNullable}"
                                      Tag="Kapanış Tarihi"
                                      behaviors:MinFoundationDateBehavior.IsEnabled="True" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Muhasebe Yöntemi" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding AccountingMethodList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding AccountingMethod}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Firma Sınıfı *" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding FirmClassList}"
                                          DisplayMember="Name"
                                          ValueMember="Value"
                                          EditValue="{Binding FirmClass, Mode=TwoWay}"
                                          NullText="Sınıf seçin" />
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Diğer Zarar" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding OtherLoss}" />
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="İstisna Zarar" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding ExceptionLoss}" />
                    </Border>
                    <StackPanel Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,4">
                        <dxe:CheckEdit Content="Kapalı" IsChecked="{Binding IsClosed}" />
                        <dxe:CheckEdit Content="Aktif" IsChecked="{Binding IsActive}" Margin="16,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 3: 1. SINIF ALANLARI -->
            <Border Grid.Row="3"
                    Background="#F9F9F9"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsClass1, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                               Text="1. SINIF ALANLARI"
                               FontSize="13" FontWeight="Bold" Foreground="#1F4E79"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Brüt Ücret" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding GrossWage}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Net Ücret" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding NetWage}" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="KDV Oranı" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding VatRateList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding VatRate}"
                                          NullText="Seçin" />
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="KDV Tutarı" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding VatAmount}" />
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Depolama Oranı" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding StorageRate}" />
                    </Border>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Depolama Tutarı" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding StorageAmount}" />
                    </Border>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Yevmiye Başlangıç No" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericTextEditStyle}"
                                      EditValue="{Binding JournalStartNumber}" />
                    </Border>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Beyanname Türü" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding DeclarationTypeList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding DeclarationType}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Fiş Sıralama Modu" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding VoucherSortModeList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding VoucherSortMode}"
                                          NullText="Seçin" />
                    </Border>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="Fiş No Hane Sayısı" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding VoucherNumberLengthList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding VoucherNumberLength}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sistem Para Birimi" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding CurrencyList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding SystemCurrency}"
                                          NullText="Seçin" />
                    </Border>
                    <TextBlock Grid.Row="6" Grid.Column="3" Text="Kur Yöntemi" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding ExchangeRateModeList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding ExchangeRateMode}"
                                          NullText="Seçin" />
                    </Border>

                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <dxe:CheckEdit Content="Fişleri Yeniden Numaralandır"
                                       IsChecked="{Binding RenumberVouchers}"
                                       Margin="0,0,24,0" />
                        <dxe:CheckEdit Content="Döviz Kullan"
                                       IsChecked="{Binding UseForeignCurrency}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 4: 2. SINIF ALANLARI -->
            <Border Grid.Row="4"
                    Background="#F9F9F9"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsClass2, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                               Text="2. SINIF ALANLARI"
                               FontSize="13" FontWeight="Bold" Foreground="#1F4E79"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Defter Türü" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding LedgerTypeList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding LedgerType}"
                                          NullText="Seçin" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Devreden KDV" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericEditStyle}"
                                      EditValue="{Binding CarryoverVat}" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gelir Başlangıç No" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericTextEditStyle}"
                                      EditValue="{Binding IncomeStartNumber}" />
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Gider Başlangıç No" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericTextEditStyle}"
                                      EditValue="{Binding ExpenseStartNumber}" />
                    </Border>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <dxe:CheckEdit Content="KDV Mükellefi"
                                       IsChecked="{Binding IsVatTaxpayer}"
                                       Margin="0,0,24,0" />
                        <dxe:CheckEdit Content="DBS Stok Defteri Kullan"
                                       IsChecked="{Binding UseDbsStockLedger}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>