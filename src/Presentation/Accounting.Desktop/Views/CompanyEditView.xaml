<UserControl x:Class="Accounting.Desktop.Views.CompanyEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:behaviors="clr-namespace:Accounting.Desktop.Behaviors">

    <UserControl.Resources>
        <Style x:Key="SectionTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1F4E79" />
            <Setter Property="Background" Value="#F5F8FB" />
            <Setter Property="BorderBrush" Value="#D0E3F5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F4E79" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F4E79" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0EEF9" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#0B5FA5" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F7F7" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E5E5" />
                                <Setter Property="Foreground" Value="#B0B0B0" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="Bold"
                   LineHeight="18"
                   LineStackingStrategy="BlockLineHeight"
                   VerticalAlignment="Top"
                   Margin="0,0,0,8" />

        <Border Grid.Row="1"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#EAF3FB"
                        BorderBrush="#D0E3F5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,0"
                        Height="34"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ShortName}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#1F4E79"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <RadioButton Content="Firma" GroupName="CompanySection" IsChecked="{Binding IsFirmaSection, Mode=OneWay}"
                                 Style="{StaticResource SectionTabStyle}" Command="{Binding SelectSectionCommand}" CommandParameter="Firma" />
                    <RadioButton Content="Dönem" GroupName="CompanySection" IsChecked="{Binding IsDonemSection, Mode=OneWay}"
                                 Style="{StaticResource SectionTabStyle}" IsEnabled="{Binding IsEditMode}"
                                 Command="{Binding SelectSectionCommand}" CommandParameter="Dönem" />
                    <RadioButton Content="Ortaklar" GroupName="CompanySection"
                                 Style="{StaticResource SectionTabStyle}" IsEnabled="{Binding IsEditMode}"
                                 Command="{Binding SelectSectionCommand}" CommandParameter="Ortaklar" />
                    <RadioButton Content="Adres" GroupName="CompanySection"
                                 Style="{StaticResource SectionTabStyle}" IsEnabled="{Binding IsEditMode}"
                                 Command="{Binding SelectSectionCommand}" CommandParameter="Adres" />
                    <RadioButton Content="İletişim" GroupName="CompanySection"
                                 Style="{StaticResource SectionTabStyle}" IsEnabled="{Binding IsEditMode}"
                                 Command="{Binding SelectSectionCommand}" CommandParameter="İletişim" />
                    <RadioButton Content="Kontak" GroupName="CompanySection"
                                 Style="{StaticResource SectionTabStyle}" IsEnabled="{Binding IsEditMode}"
                                 Command="{Binding SelectSectionCommand}" CommandParameter="Kontak" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsFirmaSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Kısa Ad *" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit EditValue="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                                      behaviors:ProperCaseBehavior.IsEnabled="True" />
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="TC Kimlik No" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource TcKimlikNumericStyle}"
                                      EditValue="{Binding IdentityNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Uzun Ad *" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit EditValue="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                      behaviors:ProperCaseBehavior.IsEnabled="True" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Vergi No *" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource VergiNoNumericStyle}"
                                      EditValue="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Kuruluş Tarihi *" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:DateEdit EditValue="{Binding FoundationDateNullable, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Vergi Dairesi" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding TaxOfficeList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding TaxOffice}"
                                          NullText="Vergi Dairesi seçin" />
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Faaliyet Kodu" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding ActivityCodeList}"
                                          DisplayMember="DisplayText" ValueMember="Code"
                                          EditValue="{Binding ActivityCode}"
                                          NullText="Faaliyet kodu seçin" />
                    </Border>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Hukuki Statü" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding LegalStatusList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding LegalStatus}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sosyal Güvenlik Kurumu" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding SocialSecurityInstitutionList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding SocialSecurityInstitution}"
                                          NullText="Seçin" />
                    </Border>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Hukuki Mahiyeti" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding LegalNatureList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding LegalNature}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Sicil Numarası" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericTextEditStyle}"
                                      EditValue="{Binding RegistryNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="Mesleki Teşekkül" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding ProfessionalOrganizationList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding ProfessionalOrganization}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Mesleki Teşekkül Üye No" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit EditValue="{Binding ProfessionalOrganizationMemberNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <TextBlock Grid.Row="6" Grid.Column="3" Text="Ticaret Sicil Memurluğu" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding TradeRegistryOfficeList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding TradeRegistryOffice}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Ticaret/Oda Sicil No" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericTextEditStyle}"
                                      EditValue="{Binding TradeRegistryNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <TextBlock Grid.Row="7" Grid.Column="3" Text="Açıklama" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="7" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit EditValue="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                      behaviors:ProperCaseBehavior.IsEnabled="True" />
                    </Border>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="MERİS No" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit Style="{StaticResource NumericTextEditStyle}"
                                      EditValue="{Binding MerisNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <TextBlock Grid.Row="8" Grid.Column="3" Text="Muhtasar Beyanname Yöntemi" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="8" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding WithholdingDeclarationMethodList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding WithholdingDeclarationMethod}"
                                          NullText="Seçin" />
                    </Border>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Muhtasar 302 Kaydı" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                          ItemsSource="{Binding Create302RecordList}"
                                          DisplayMember="Name" ValueMember="Code"
                                          EditValue="{Binding Create302RecordForWithholding}"
                                          NullText="Seçin" />
                    </Border>
                    <TextBlock Grid.Row="9" Grid.Column="3" Text="Bordro Kesinleşme Tarihi" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="9" Grid.Column="4" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:DateEdit EditValue="{Binding PayrollCutoffDateNullable, UpdateSourceTrigger=PropertyChanged}"
                                      Tag="Bordro Kesinleşme Tarihi"
                                      behaviors:MinFoundationDateBehavior.IsEnabled="True" />
                    </Border>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Gelir İdaresi Kullanıcı Adı" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <Border Grid.Row="10" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,4">
                        <dxe:TextEdit EditValue="{Binding TaxAuthorityUsername, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,4">
                        <dxe:CheckEdit Content="Münhasıran sürekli olarak işlenmiş altın, gümüş alım/satımı ve imali ile iştigal eden mükellef mi?"
                                       IsChecked="{Binding IsSpecialTaxpayer}" Margin="0,0,0,2" />
                        <dxe:CheckEdit Content="DBS'ye Fiş Detay Açıklama yerine Fiş Açıklama Gönder"
                                       IsChecked="{Binding SendReceiptDescriptionForDbs}" Margin="0,0,0,2" />
                        <dxe:CheckEdit Content="İşletme Defteri Dökümüne Fiş Detay Açıklama yerine Fiş Açıklama Gönder"
                                       IsChecked="{Binding SendReceiptDescriptionForLedger}" Margin="0,0,0,2" />
                        <dxe:CheckEdit Content="Bu müşteriye sadece Admin kullanıcısı erişebilsin"
                                       IsChecked="{Binding AdminOnlyAccess}" Margin="0,0,0,2" />
                        <TextBlock Text="GEÇMİŞ YIL ZARARLARI"
                                   FontSize="13" FontWeight="Bold" Foreground="#1F4E79"
                                   HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="11" Grid.Column="3" Grid.ColumnSpan="2"
                               Text="Geçmiş yıl zararlarını eklemek için dönem açmanız gerekir!"
                               FontSize="16" FontWeight="Bold" Foreground="#1F4E79"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding IsNotEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </ScrollViewer>

            <ContentControl x:Name="DonemContent"
                            Visibility="{Binding IsDonemSection, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Background="#F9F9F9"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    Visibility="{Binding IsPlaceholderSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSection}"
                               FontSize="22" FontWeight="Bold" Foreground="#1F4E79"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding PlaceholderMessage}"
                               FontSize="14" Foreground="#666"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="480" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>