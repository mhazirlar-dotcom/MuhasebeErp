<dx:ThemedWindow x:Class="Accounting.Desktop.Windows.AddPeriodDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 Title="Dönem Ekle"
                 Width="440"
                 Height="380"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowIcon="False"
                 UseLayoutRounding="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Başlık -->
        <TextBlock Grid.Row="0"
                   Text="Yeni Dönem"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#1F4E79"
                   Margin="0,0,0,4" />

        <!-- Row 1: Açıklama -->
        <TextBlock Grid.Row="1"
                   Text="Başlangıç ayını ve yılını seçin. 12 aylık dönem otomatik oluşturulur."
                   FontSize="11"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <!-- Row 2: Ay ComboBox -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Başlangıç Ayı *"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="12" />

            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                  ItemsSource="{Binding AvailableMonths}"
                                  DisplayMember="Name"
                                  SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                  NullText="Ay seçin" />
            </Border>
        </Grid>

        <!-- Row 3: Yıl ComboBox -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Başlangıç Yılı *"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="12" />

            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <dxe:ComboBoxEdit Style="{StaticResource FilteringComboBoxStyle}"
                                  ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                  NullText="Yıl seçin" />
            </Border>
        </Grid>

        <!-- Row 4: Preview + Validation -->
        <StackPanel Grid.Row="4" VerticalAlignment="Top">

            <!-- Preview Bandı -->
            <Border Background="#EAF3FB"
                    BorderBrush="#D0E3F5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Oluşturulacak Dönem"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#2C5C8F"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding PreviewText}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#1F4E79" />
                </StackPanel>
            </Border>

            <!-- Validation Mesajı (boşken görünmez) -->
            <TextBlock Text="{Binding ValidationMessage}"
                       FontSize="12"
                       Foreground="#C62828"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

        </StackPanel>

        <!-- Row 5: Butonlar -->
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <dx:SimpleButton Grid.Column="0"
                             Content="İptal"
                             Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                             Command="{Binding CancelCommand}"
                             HorizontalAlignment="Stretch" />

            <dx:SimpleButton Grid.Column="2"
                             Content="Ekle"
                             Glyph="{dx:DXImage Image=Add_16x16.png}"
                             Command="{Binding ConfirmCommand}"
                             HorizontalAlignment="Stretch"
                             IsDefault="True" />
        </Grid>
    </Grid>
</dx:ThemedWindow>