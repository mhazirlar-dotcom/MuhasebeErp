<dx:ThemedWindow x:Class="Accounting.Desktop.Windows.FirstSetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 Title="İlk Kurulum"
                 Width="480"
                 Height="600"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="İlk Kurulum"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Sisteme ilk kez giriş yapılıyor. Yönetici hesabı oluşturun."
                   FontSize="12"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,24" />

        <Border Grid.Row="2"
                Style="{StaticResource FieldBorderStyle}"
                Margin="0,0,0,12">
            <dxe:TextEdit EditValue="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                          NullText="Kullanıcı Adı" />
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource FieldBorderStyle}"
                Margin="0,0,0,12">
            <dxe:TextEdit EditValue="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                          NullText="Ad Soyad" />
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource FieldBorderStyle}"
                Margin="0,0,0,12">
            <dxe:TextEdit EditValue="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                          NullText="E-posta" />
        </Border>

        <Border Grid.Row="5"
                Style="{StaticResource FieldBorderStyle}"
                Margin="0,0,0,12">
            <dxe:PasswordBoxEdit EditValue="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 NullText="Şifre" />
        </Border>

        <Border Grid.Row="6"
                Style="{StaticResource FieldBorderStyle}"
                Margin="0,0,0,20">
            <dxe:PasswordBoxEdit EditValue="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                 NullText="Şifre Tekrar" />
        </Border>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <dx:SimpleButton Grid.Column="0"
                             Content="İptal"
                             Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                             Command="{Binding CancelCommand}"
                             HorizontalAlignment="Stretch" />

            <dx:SimpleButton Grid.Column="2"
                             Content="Kaydet"
                             Glyph="{dx:DXImage Image=Apply_16x16.png}"
                             Command="{Binding SaveCommand}"
                             HorizontalAlignment="Stretch"
                             IsEnabled="{Binding IsNotBusy}" />
        </Grid>
    </Grid>
</dx:ThemedWindow>